# Copy this file to .env next to docker-compose.yml and fill in real values; .env is ignored by git.
# Compose reads .env for the ${...} values in docker-compose.yml and passes them to the containers as environment variables.

# SQL Server's sa password. SQL Server refuses weak ones: at least 8 characters from three of these four groups: upper case, lower case, digits, symbols.
DB_PASSWORD=Change_this_Password1

# At least 32 characters. Both APIs share it, so a token from the POS API is valid at the Notification API.
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters

# Passwords the seed loader gives the admin and the cashier of each store when the POS database is empty.
SEED_ADMIN_PASSWORD=Admin_Change_2026
SEED_CASHIER_PASSWORD=Cashier_Change_2026
