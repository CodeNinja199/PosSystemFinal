{
  "Routes": [
    {
      "UpstreamPathTemplate": "/pos/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Patch", "Delete" ],
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "shop-api", "Port": 8080 } ]
    },
    {
      "UpstreamPathTemplate": "/notifications/{everything}",
      "UpstreamHttpMethod": [ "Get", "Patch" ],
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "notifications-api", "Port": 8080 } ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://gateway:8080"
  }
}